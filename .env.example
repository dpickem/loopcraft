# Required for fetching/searching posts with app-only auth.
X_API_BEARER_TOKEN=

# Optional: OAuth 2.0 app credentials. These identify the X app, but do not
# authenticate a user by themselves.
X_API_OAUTH2_CLIENT_ID=
X_API_OAUTH2_CLIENT_SECRET=

# Optional: OAuth 2.0 user-context tokens. Set these after completing the
# Authorization Code with PKCE flow if you want /2/users/me support.
X_API_OAUTH2_ACCESS_TOKEN=
X_API_OAUTH2_REFRESH_TOKEN=

# --- Loopcraft loop config overrides (public/private split) ------------------
# Private values that override a loop's public config asset at run time. The env
# var name is derived from the skill asset path:
#   skills/<skill>/<file>.txt  ->  LOOPCRAFT_<SKILL>_<FILE>  (upper, non-alnum -> _)
# Comma- or newline-separated. Leave blank to fall back to channels.local.txt or
# the committed public file.
LOOPCRAFT_SLACK_TRIAGE_CHANNELS=
